# Chain config file in config/ (without .toml).
CHAIN=robinhood
# Optional: overrides the public RPC in the chain config.
RPC_URL=
# Where discovery reads logs from: rpc (default) or hypersync.
LOG_SOURCE=rpc
# Required only when LOG_SOURCE=hypersync.
ENVIO_API_TOKEN=
# Seconds between health checks in `run`.
POLL_SECONDS=10

# The liquidating EOA. Without it the bot simulates only and never sends.
PRIVATE_KEY=
# Set to 1 to send transactions. Anything else is a dry run.
ARM=
# Swap output may be this far below the KyberSwap quote, or the pool's price at simulation time.
MAX_SLIPPAGE_BPS=100
# Skip a liquidation whose simulated profit is below this share of the flash loan.
MIN_PROFIT_BPS=10
# Optional: identifies this bot to the KyberSwap API.
KYBERSWAP_CLIENT_ID=
